{"op": "geometry", "x": 100, "y": 80, "width": 900, "height": 560}
{"op": "waitText", "text": "$"}
{"op": "type", "text": "printf 'alpha beta gamma\\ndelta epsilon zeta\\n'\r"}
{"op": "waitText", "text": "epsilon zeta"}
