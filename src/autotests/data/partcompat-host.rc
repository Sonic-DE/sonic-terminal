     A minimal host window GUI for PartCompatTest, like the ones Kate or KDevelop provide. -->
<!DOCTYPE gui SYSTEM "kpartgui.dtd">
<gui name="partcompathost" version="1">
    <MenuBar>
        <Menu name="file"><text>File</text></Menu>
        <Menu name="edit"><text>Edit</text></Menu>
        <Menu name="view"><text>View</text></Menu>
        <Menu name="settings"><text>Settings</text></Menu>
    </MenuBar>
</gui>
